{
  "expo": {
    "name": "grandma-app",
    "slug": "grandma-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "grandma-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.sauceroom.grandma",
      "buildNumber": "4",
      "icon": "./assets/icon.png",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Save your daily affirmation as an image to share anywhere.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "C7H9AXWR6A",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.co.sauceroom.grandma"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0E8"
      },
      "package": "com.grandmacoder.grandmaapp",
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1A1713"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock grandma.app with Face ID."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#E58BB4"
        }
      ],
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "grandmaapp"
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Grandma",
              "label": "Grandma",
              "description": "Your journey at a glance, one tap to log",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e90f69b-67ad-4c0e-82b5-12677de0e331"
      }
    },
    "owner": "grandma.app"
  }
}
